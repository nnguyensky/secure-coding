node_modules/
.DS_Store

# Generated per-session HTML reports
# Keep reports/security.html (scaffold), ignore timestamped copies
reports/security-*.html

# CI artifacts (generated by .github/workflows/security-scan.yml)
results.sarif
sbom.json
*.sarif

# Done Gate answers are per-developer, per-commit state
checks/gate.json

# Local run state — rewritten on every scan/audit, so tracking it means every
# run dirties the tree (six "Update audit.json" commits in the last twelve).
checks/findings.jsonl
checks/audit.json

# Derived test count, regenerated by hooks/test.js on every green run
checks/.test-count
